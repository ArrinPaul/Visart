# VISART Environment Variables

# Demo Mode Flag (Set to "false" to connect live Gemini & Supabase)
NEXT_PUBLIC_VISART_DEMO_MODE=true

# Member B — Gemini API Key (Server Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Member C — Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

