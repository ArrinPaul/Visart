# VISART Environment Variables

# Demo Mode Flag (Set to "false" to use live Gemini & Supabase)
NEXT_PUBLIC_VISART_DEMO_MODE=false

# Member B — Gemini API Key (Server Side Only)
GEMINI_API_KEY=

# Member C — Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
