# VISART Environment Variables

# Demo Mode Flag (Set to "false" to connect live Gemini & Supabase)
NEXT_PUBLIC_VISART_DEMO_MODE=true

# Member B — Gemini API Key (Server Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Member C — Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# Admin Authentication (Phase 1, Batch 2) — see docs/ADMIN_SESSIONS.md
# Server-side only, never exposed to the browser (no NEXT_PUBLIC_ prefix). Required for
# /api/admin/auth/login and /api/admin/auth/logout to function at all — both fail closed
# (reject every request) if this is missing or malformed, rather than falling back to anything
# less privileged.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# The canonical origin (scheme://host[:port]) this deployment is actually served from, used to
# reject cross-origin login/logout requests. Must exactly match what users' browsers see — e.g.
# http://localhost:3000 for local development, or your real https://... domain in production.
APP_ORIGIN=http://localhost:3000

# Photo verification (ml-service/). Server-side only. Verification also needs
# SUPABASE_SERVICE_ROLE_KEY, APP_ORIGIN and NEXT_PUBLIC_VISART_DEMO_MODE=false.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=choose_a_long_random_value
